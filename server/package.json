{
  "name": "@odontoplan/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:push": "prisma db push --skip-generate",
    "db:studio": "prisma studio",
    "seed": "prisma db push --skip-generate && tsx prisma/seed.ts",
    "test": "vitest run",
    "sync": "tsx src/sync.ts",
    "purge-seed": "tsx prisma/purge-seed.ts",
    "start:prod": "prisma db push --skip-generate && node dist/src/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "prisma": "6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
