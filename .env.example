# Copie para server/.env (opcional). Sem nenhuma variável o app roda 100% local com o seed.

# IA (textos da proposta). Sem a chave, usa templates de fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PORT=3001

# Clinicorp (Gerenciar Assinatura → Acesso Externo e Integrações → Integrações).
# Com USER + TOKEN preenchidos, POST /api/sync e `npm run sync` importam da API real
# para uma clínica separada da do seed, e o app passa a mostrar essa clínica.
CLINICORP_API_USER=
CLINICORP_API_TOKEN=
# id do assinante (query subscriber_id); default = CLINICORP_API_USER
CLINICORP_SUBSCRIBER_ID=
# opcionais
# CLINICORP_BUSINESS_ID=     # unidade específica quando a conta tem várias clínicas
# CLINICORP_TZ_OFFSET=-03:00 # fuso da agenda
# CLINICORP_BASE_URL=https://api.clinicorp.com/rest/v1
# CLINIC_ID=                 # força a clínica exibida (id local)

# Banco. Local: SQLite em server/prisma/dev.db. Railway: file:/data/odontoplan.db com volume em /data.
DATABASE_URL="file:./dev.db"

# ── Produção (Railway) ──
# Senha única de acesso ao app. Obrigatória em produção; vazia = sem login (uso local).
APP_PASSWORD=
# Origens do frontend autorizadas (separadas por vírgula), ex.: https://odontoplan.vercel.app
CORS_ORIGIN=

# ── Frontend (Vercel) ──
# VITE_API_URL=https://<servico>.up.railway.app   # URL pública do backend, sem /api
